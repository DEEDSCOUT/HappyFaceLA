---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import MobileStickyCtas from "../components/layout/MobileStickyCtas.astro";
import SeoHead from "../components/seo/SeoHead.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
  jsonLd?: Array<Record<string, unknown>>;
  homepageVisualBaseline?: string;
}

const {
  title,
  description,
  canonicalPath,
  noindex = false,
  jsonLd = [],
  homepageVisualBaseline,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead title={title} description={description} canonicalPath={canonicalPath} noindex={noindex} jsonLd={jsonLd} />
    {homepageVisualBaseline && (
      <meta name="hfla-homepage-visual-baseline" content={homepageVisualBaseline} />
    )}
    <!-- Production analytics is fail-closed outside the two approved production hosts. -->
    <script>
      import { installProductionAnalytics } from "../lib/analytics/production-analytics.ts";
      installProductionAnalytics();
    </script>
  </head>
  <body class="bg-slate-50 text-slate-900">
    <Header />
    <main class="pb-24 md:pb-0">
      <slot />
    </main>
    <Footer />
    <MobileStickyCtas />

    <script>
      import { captureBrowserAttribution } from "../lib/attribution/browser-attribution.ts";
      import { trackProductionAnalyticsEvent } from "../lib/analytics/production-analytics.ts";

      function trackEvent(eventName: string, params: Record<string, unknown> = {}) {
        trackProductionAnalyticsEvent(eventName, params);
      }

      captureBrowserAttribution();

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) {
          return;
        }
        const el = target.closest("[data-track-event]");
        if (!el) {
          return;
        }
        const eventName = el.getAttribute("data-track-event");
        if (!eventName) {
          return;
        }
        trackEvent(eventName, {
          source_page: window.location.pathname
        });
      });
    </script>
  </body>
</html>
