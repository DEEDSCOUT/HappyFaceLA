---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import MobileStickyCtas from "../components/layout/MobileStickyCtas.astro";
import SeoHead from "../components/seo/SeoHead.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
  jsonLd?: Array<Record<string, unknown>>;
  homepageVisualBaseline?: string;
}

const {
  title,
  description,
  canonicalPath,
  noindex = false,
  jsonLd = [],
  homepageVisualBaseline,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead title={title} description={description} canonicalPath={canonicalPath} noindex={noindex} jsonLd={jsonLd} />
    {homepageVisualBaseline && (
      <meta name="hfla-homepage-visual-baseline" content={homepageVisualBaseline} />
    )}
    <!-- Google Analytics 4 tracking for Happy Faces LA -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-7NH6RY78TK"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "G-7NH6RY78TK");
    </script>
    <!-- Microsoft Clarity tracking for Happy Faces LA -->
    <script is:inline>
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "wsw4v74jpw");
    </script>
  </head>
  <body class="bg-slate-50 text-slate-900">
    <Header />
    <main class="pb-24 md:pb-0">
      <slot />
    </main>
    <Footer />
    <MobileStickyCtas />

    <script>
      import { captureBrowserAttribution } from "../lib/attribution/browser-attribution.ts";

      function trackEvent(eventName: string, params: Record<string, unknown> = {}) {
        window.dataLayer = window.dataLayer || [];
        if (typeof window.gtag === "function") {
          window.gtag("event", eventName, params);
        } else {
          window.dataLayer.push({ event: eventName, ...params });
        }
      }

      captureBrowserAttribution();

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) {
          return;
        }
        const el = target.closest("[data-track-event]");
        if (!el) {
          return;
        }
        const eventName = el.getAttribute("data-track-event");
        if (!eventName) {
          return;
        }
        trackEvent(eventName, {
          source_page: window.location.pathname
        });
      });
    </script>
  </body>
</html>
