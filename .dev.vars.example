# Local Wrangler secret overrides for Pages Functions development.
# Copy this template as .dev.vars and fill in real values.
# .dev.vars is gitignored — never commit real secrets.
# These values are injected as env vars into Pages Functions during: npm run pages:dev

OWNER_NOTIFICATION_EMAIL=local-test@example.com
# CRM_WEBHOOK_URL: POST endpoint that receives the lead JSON payload.
# Production: deploy scripts/lead-webhook-apps-script.js as a Google Apps Script
# Web App and paste its URL here. See the script file for full setup instructions.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
GA4_MEASUREMENT_ID=
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_LEAD_CONVERSION_LABEL=

# Dedicated nonproduction artist payout configuration. D1 binding is configured
# separately as PAYOUTS_D1; never reuse the customer booking databases.
STRIPE_ARTIST_PAYOUTS_ENABLED=false
STRIPE_ARTIST_INTAKE_ENABLED=false
STRIPE_ARTIST_ONBOARDING_ENABLED=false
STRIPE_ARTIST_TRANSFERS_ENABLED=false
STRIPE_ARTIST_PAYOUTS_ENV=sandbox
STRIPE_PAYOUTS_SANDBOX_SECRET_KEY=
STRIPE_PAYOUTS_SANDBOX_PLATFORM_ACCOUNT_ID=
STRIPE_PAYOUTS_SANDBOX_ACCOUNT_WEBHOOK_SECRET=
STRIPE_PAYOUTS_SANDBOX_PAYOUT_WEBHOOK_SECRET=
STRIPE_PAYOUTS_LIVE_SECRET_KEY=
STRIPE_PAYOUTS_LIVE_PLATFORM_ACCOUNT_ID=
STRIPE_PAYOUTS_LIVE_ACCOUNT_WEBHOOK_SECRET=
STRIPE_PAYOUTS_LIVE_PAYOUT_WEBHOOK_SECRET=
PAYOUT_MIN_RESERVE_CENTS=
PAYOUT_PUBLIC_BASE_URL=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
PAYOUT_OWNER_EMAILS=
PAYOUT_ADMIN_EMAILS=
PAYOUT_SANDBOX_CRM_WRITE_URL=
PAYOUT_SANDBOX_CRM_READ_URL=
PAYOUT_SANDBOX_CRM_ALLOWED_ORIGIN=https://script.google.com
PAYOUT_SANDBOX_CRM_WEBHOOK_SECRET=
PAYOUT_LIVE_CRM_WRITE_URL=
PAYOUT_LIVE_CRM_READ_URL=
PAYOUT_LIVE_CRM_ALLOWED_ORIGIN=https://script.google.com
