{
  "name": "happyfacesla",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "pages:dev": "npm run build && wrangler pages dev dist --compatibility-date=2024-09-23",
    "build": "astro build && node scripts/build-manifest.mjs",
    "guard:owner-baseline": "node scripts/guard-owner-baseline.mjs",
    "test": "npm run test:lead-validation && npm run test:outcome-writeback && npm run test:form-parity && npm run test:attribution && npm run test:browser-attribution && npm run test:submission-client && npm run test:migration && npm run test:analytics-policy",
    "test:lead-validation": "node tests/api/lead-validation.mjs",
    "test:outcome-writeback": "node tests/api/outcome-writeback.mjs",
    "test:form-parity": "node tests/api/form-parity.mjs",
    "test:attribution": "node tests/unit/atomic-attribution.mjs",
    "test:browser-attribution": "node tests/unit/browser-attribution.mjs",
    "test:submission-client": "node tests/unit/submission-client.mjs",
    "test:migration": "node tests/db/migration-contract.mjs",
    "test:analytics-policy": "node tests/unit/production-analytics-policy.mjs",
    "verify:release": "npm run guard:owner-baseline && npm run build",
    "qa:postbuild": "node scripts/qa-postbuild.mjs",
    "qa:ap02-ap03-postbuild": "node tests/postbuild/ap02-ap03-contracts.mjs",
    "qa:analytics-host-policy": "node tests/postbuild/production-analytics-policy.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.3",
    "stripe": "^22.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "wrangler": "^4.92.0"
  }
}
